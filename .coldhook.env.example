# Copy to .coldhook.env and fill in YOUR values. Keep .coldhook.env untracked.
TEAM_ID=YOUR_TEAM_ID
BUNDLE_ID=com.example.app
DEVICE_UDID=YOUR_DEVICE_UDID         # xcrun xctrace list devices
COREDEVICE_ID=YOUR_COREDEVICE_ID     # xcrun devicectl list devices (Identifier column)
SIGN_IDENTITY=Apple Development      # for --hook re-sign; `security find-identity -v -p codesigning`
